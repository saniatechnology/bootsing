ANTHROPIC_API_KEY=sk-ant-...
# Optional: the Claude model used for chat and research (defaults to claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-5
PORT=3000

# Supabase — server-side only. Never expose the service-role key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Fixed id for the single current user until real auth is added.
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000
